{
    "app": {
        "Unit": {
            "all": {
                "module": "masters",
                "resource": "Unit",
                "action": "all",
                "resultKey": "Units",
                "transformation": {
                    "transform": {
                        "UNIT": {
                            "alterKey": "Units"
                        }
                    },
                    "Units": {
                        "transform": {
                            "@_NAME": {
                                "alterKey": "Name"
                            },
                            "@_RESERVEDNAME": {
                                "alterKey": "ReserveName"
                            }
                        }
                    }
                }
            }
        },
        "StockItem": {
            "withBatches": {
                "module": "masters",
                "resource": "StockItem",
                "action": "withBatches",
                "resultKey": "StockItems",
                "transformation": {
                    "transform": {
                        "STOCKITEM": {
                            "alterKey": "StockItems"
                        }
                    },
                    "StockItems": {
                        "transform": {
                            "@_NAME": {
                                "alterKey": "Name"
                            },
                            "@_RESERVEDNAME": {
                                "alterKey": "ReserveName"
                            },
                            "BASEUNITS": {
                                "alterKey": "Units",
                                "valueKey": "#text"
                            },
                            "BATCHALLOCATIONS.LIST": {
                                "alterKey": "Batches",
                                "valueType": "array",
                                "transform": {
                                    "GODOWNNAME": {
                                        "alterKey": "godownName"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "Ledger": {
            "withGstDetails": {
                "module": "masters",
                "resource": "Ledger",
                "action": "withGstDetails",
                "resultKey": "Ledgers",
                "transformation": {
                    "transform": {
                        "LEDGER": {
                            "alterKey": "Ledgers"
                        }
                    },
                    "Ledgers": {
                        "transform": {
                            "@_NAME": {
                                "alterKey": "Name"
                            },
                            "@_RESERVEDNAME": {
                                "alterKey": "ReserveName"
                            },
                            "LEDGSTREGDETAILS.LIST": {
                                "alterKey": "GstDetails",
                                "transform": {
                                    "GSTIN": {
                                        "alterKey": "GSTIN",
                                        "valueKey": "#text"
                                    },
                                    "GSTREGISTRATIONTYPE": {
                                        "alterKey": "RegistrationType",
                                        "valueKey": "#text"
                                    },
                                    "STATE": {
                                        "alterKey": "State",
                                        "valueKey": "#text"
                                    },
                                    "PLACEOFSUPPLY": {
                                        "alterKey": "PlaceOfSupply",
                                        "valueKey": "#text"
                                    },
                                    "APPLICABLEFROM": {
                                        "alterKey": "ApplicableFrom",
                                        "valueKey": "#text"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "vouchers": {
            "sales": {
                "simple": {
                    "module": "vouchers",
                    "resource": "sales",
                    "action": "period",
                    "resultKey": "sales",
                    "transformation": {
                        "transform": {
                            "VOUCHER": {
                                "alterKey": "sales"
                            }
                        },
                        "sales": {
                            "transform": {
                                "DATE": {
                                    "alterKey": "Date",
                                    "valueKey": "#text"
                                },
                                "VOUCHERTYPENAME": {
                                    "alterKey": "VoucherTypeName"
                                },
                                "PARTYLEDGERNAME": {
                                    "alterKey": "PartyLedgerName",
                                    "valueKey": "#text"
                                },
                                "VOUCHERNUMBER": {
                                    "alterKey": "VoucherNumber"
                                },
                                "REFERENCE": {
                                    "alterKey": "Reference",
                                    "valueKey": "#text"
                                },
                                "ISDEEMEDPOSITIVE": {
                                    "alterKey": "IsDeemedPositive",
                                    "valueKey": "#text"
                                },
                                "ISINVOICE": {
                                    "alterKey": "IsInvoice"
                                },
                                "MASTERID": {
                                    "alterKey": "MasterId",
                                    "valueKey": "#text"
                                },
                                "AMOUNT": {
                                    "alterKey": "Amount",
                                    "valueKey": "#text"
                                },
                                "ALLINVENTORYENTRIES.LIST": {
                                    "alterKey": "InventoryEntries",
                                    "transform": {
                                        "STOCKITEMNAME": {
                                            "alterKey": "StockItemName"
                                        },
                                        "ISDEEMEDPOSITIVE": {
                                            "alterKey": "IsDeemedPositive"
                                        },
                                        "RATE": {
                                            "alterKey": "Rate"
                                        },
                                        "AMOUNT": {
                                            "alterKey": "Amount"
                                        },
                                        "ACTUALQTY": {
                                            "alterKey": "ActualQty"
                                        },
                                        "BILLEDQTY": {
                                            "alterKey": "BilledQty"
                                        },
                                        "BATCHALLOCATIONS.LIST": {
                                            "alterKey": "BatchAllocations",
                                            "transform": {
                                                "GODOWNNAME": {
                                                    "alterKey": "GodownName"
                                                },
                                                "BATCHNAME": {
                                                    "alterKey": "BatchName"
                                                },
                                                "DESTINATIONGODOWNNAME": {
                                                    "alterKey": "DestinationGodownName"
                                                },
                                                "BATCHID": {
                                                    "alterKey": "BatchId",
                                                    "valueKey": "#text"
                                                },
                                                "BATCHDISCOUNT": {
                                                    "alterKey": "BatchDiscount",
                                                    "valueKey": "#text"
                                                },
                                                "AMOUNT": {
                                                    "alterKey": "Amount"
                                                },
                                                "ACTUALQTY": {
                                                    "alterKey": "ActualQty"
                                                },
                                                "BILLEDQTY": {
                                                    "alterKey": "BilledQty"
                                                },
                                                "BATCHRATE": {
                                                    "alterKey": "BatchRate",
                                                    "valueKey": "#text"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}